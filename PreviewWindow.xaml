<Window x:Class="LayoutPreviewPrototype.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Manual">
    <Canvas x:Name="RootCanvas" Width="340" Height="44" ClipToBounds="False">
        <Border x:Name="PreviewBorder"
                Canvas.Left="170" Canvas.Top="4"
                Padding="7,2,7,3"
                Cursor="Hand"
                MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="#669A9A9A"
                Background="#16000000"
                Opacity="0"
                RenderTransformOrigin="0,0.5"
                SnapsToDevicePixels="True">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock x:Name="PreviewText"
                       Text="Привет"
                       FontFamily="Segoe UI"
                       FontSize="15"
                       Foreground="#A89A9A9A"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType"/>
        </Border>
    </Canvas>
</Window>
