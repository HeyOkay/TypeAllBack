<Window x:Class="LayoutPreviewPrototype.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="340" Height="44"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        SizeToContent="Manual">
    <Canvas x:Name="RootCanvas" Width="340" Height="44" ClipToBounds="False">
        <!-- One layer for the pill and its shadow, so appearing and hiding fade and blur
             them together. -->
        <Canvas x:Name="PreviewLayer" ClipToBounds="False">
        <!-- Glass only: an even, all-around shadow outside the pill. The clip removes the
             pill's own area so the translucent glass is not darkened from below. -->
        <Grid x:Name="GlassShadowClip" Canvas.Left="170" Canvas.Top="4" IsHitTestVisible="False" Visibility="Collapsed">
            <Border x:Name="GlassShadow" Background="Black" CornerRadius="8"/>
        </Grid>
        <Border x:Name="PreviewBorder"
                Canvas.Left="170" Canvas.Top="4"
                Padding="4,2,4,3"
                Cursor="Hand"
                MouseLeftButtonDown="PreviewBorder_MouseLeftButtonDown"
                CornerRadius="6"
                BorderThickness="1"
                BorderBrush="#669A9A9A"
                Background="#FF333333"
                Opacity="0"
                RenderTransformOrigin="0,0.5"
                SnapsToDevicePixels="True"
                ClipToBounds="True">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PreviewScale" ScaleX="1" ScaleY="1"/>
                    <TranslateTransform x:Name="PreviewTranslate" X="0" Y="0"/>
                </TransformGroup>
            </Border.RenderTransform>
            <TextBlock x:Name="PreviewText"
                       Text="Привет"
                       FontFamily="Consolas"
                       FontSize="15"
                       Foreground="#CF9A9A9A"
                       TextOptions.TextFormattingMode="Display"
                       TextOptions.TextRenderingMode="ClearType"
                       RenderOptions.ClearTypeHint="Enabled"/>
            <!-- A transparent (layered) window silently falls back to grayscale text.
                 The hint restores ClearType, as in the browser reference: the pill
                 behind the text is drawn by this window, so the text is never over
                 undefined content. -->
        </Border>
        </Canvas>
    </Canvas>
</Window>
