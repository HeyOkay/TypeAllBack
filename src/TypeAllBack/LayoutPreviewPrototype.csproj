<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>TypeAllBack</AssemblyName>
    <Product>TypeAllBack</Product>
    <Title>TypeAllBack</Title>
    <Description>Keyboard layout preview and correction</Description>
    <Version>0.1.4</Version>
    <AssemblyVersion>0.1.4.0</AssemblyVersion>
    <FileVersion>0.1.4.0</FileVersion>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TypeAllBack.ico</ApplicationIcon>
  </PropertyGroup>
<ItemGroup>
  <Resource Include="Assets\TypeAllBack.ico" />
  <Content Include="..\..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="..\..\LICENSE-NOTICE.txt" Link="LICENSE-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="..\..\LICENSING.md" Link="LICENSING.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="Models\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <Content Include="Models\README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  <EmbeddedResource Include="..\..\Tools\InstallUpdate.ps1" LogicalName="TypeAllBack.InstallUpdate.ps1" />
  <EmbeddedResource Include="Assets\Correction.wav" LogicalName="TypeAllBack.Correction.wav" />
  <EmbeddedResource Include="Models\en.json" LogicalName="LayoutPreview.Models.en.json" />
  <EmbeddedResource Include="Models\ru.json" LogicalName="LayoutPreview.Models.ru.json" />
  <!-- Local test images for the field tester: Debug output only, never published or embedded. -->
  <None Update="TestAssets\**" Condition="'$(Configuration)' == 'Debug'" CopyToOutputDirectory="PreserveNewest" />
</ItemGroup></Project>
